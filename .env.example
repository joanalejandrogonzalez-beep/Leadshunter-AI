# LeadHunter AI — Plantilla de Configuración de Entorno (.env.example)
# Copia este archivo como .env y completa los valores correspondientes.

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Clave secreta para firma de tokens JWT (OBLIGATORIA EN PRODUCCIÓN: genera al menos 32 caracteres aleatorios)
# Ejemplo en terminal: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=tu_clave_secreta_jwt_de_al_menos_32_caracteres

# Conexión a Base de Datos
# SQLite local: sqlite:///data/leadhunter_v2.db
# PostgreSQL (producción): postgresql://usuario:password@localhost:5432/leadhunter
DATABASE_URL=sqlite:///data/leadhunter_v2.db

# Credenciales maestras del administrador inicial (usadas al migrar/sembrar la BD)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=TuPasswordSeguroDeAdminAqui123!

# Orígenes CORS permitidos para la API REST FastAPI (separados por coma)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# (Opcional) API Key de Google Gemini para interpretación de lenguaje natural
# Si se deja vacío, el asistente opera con su motor semántico heurístico interno sin costo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# (Opcionales) Búsqueda web programática; Serper tiene prioridad sobre Tavily.
# Sin estas claves se usa DuckDuckGo como alternativa gratuita.
SERPER_API_KEY=
TAVILY_API_KEY=
